# Publik adress (används för kalenderflöde, sitemap och delningsbilder)
SITE_URL=https://statlin.se

# Första administratören skapas automatiskt vid första start om databasen saknar konton.
# Lösenordet måste bytas vid första inloggningen. Platshållaren nedan vägras – skriv ett eget på minst 10 tecken.
ADMIN_EMAIL=webb@statlin.se
ADMIN_PASSWORD=byt-mig-till-nagot-langt

# Var databasen och uppladdningar sparas (sätts till /data i Docker)
# DATA_DIR=./data

# Inloggningskakan blir automatiskt Secure via HTTPS. Sätt true för att alltid kräva HTTPS.
# COOKIE_SECURE=true

# Extra värdar som får skicka formulär (bara om en proxy inte skickar vidare rätt host)
# ALLOWED_ORIGINS=statlin.se,*.statlin.se

# Krävs i produktion: rubriken med besökarens IP som värden eller proxyn framför sajten skriver, och som
# besökaren inte kan påverka (README → Miljövariabler). Utan den räknar inloggningsspärren alla besökare
# som en, och loggen varnar vid start. På Fly.io är det fly-client-ip, satt i fly.toml (där används inte
# .env). Bakom en egen proxy: x-real-ip, med nginx proxy_set_header X-Real-IP $remote_addr; eller med
# Caddy header_up X-Real-IP {remote_host}. Aldrig x-forwarded-for – där kan besökaren fylla i värdet.
# CLIENT_IP_HEADER=x-real-ip
