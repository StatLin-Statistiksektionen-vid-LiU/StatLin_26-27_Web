# Publik adress (används för kalenderflöde, sitemap och delningsbilder)
SITE_URL=https://statlin.se

# Första administratören skapas automatiskt vid första start om databasen saknar konton.
# Lösenordet måste bytas vid första inloggningen.
ADMIN_EMAIL=webb@statlin.se
ADMIN_PASSWORD=byt-mig-till-nagot-langt

# Var databasen och uppladdningar sparas (sätts till /data i Docker)
# DATA_DIR=./data

# Inloggningskakan blir automatiskt Secure via HTTPS. Sätt true för att alltid kräva HTTPS.
# COOKIE_SECURE=true

# Extra värdar som får skicka formulär (bara om en proxy inte skickar vidare rätt host)
# ALLOWED_ORIGINS=statlin.se,*.statlin.se

# Inloggningsspärren per IP litar på det sista värdet i X-Forwarded-For. Ange en rubrik
# som värden själv sätter om den ska användas i stället (Railway: x-real-ip, Fly.io: fly-client-ip).
# CLIENT_IP_HEADER=x-real-ip
